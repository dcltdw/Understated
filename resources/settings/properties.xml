         10 Stress, 11 PulseOx, 12 Elevation, 13 Pressure, 14 Temperature,
         15 DeviceBattery, 16 Notifications, 17 WeatherTemp, 18 WeatherCond.
         Fmt: 0 Value, 1 Label+value, 2 Icon+value.
         Col: 0 White,1 LtGray,2 Red,3 Orange,4 Yellow,5 Green,6 Cyan,7 Blue,
              8 Magenta,9 Pink,10 Black,11 Accent.
         Size: 0 Tiny,1 Small,2 Medium,3 Large. -->

    <!-- 12 o'clock (top) - default Off -->
