    <property id="colorTheme" type="number">0</property>
    <property id="secondHand" type="number">0</property>   <!-- 0 Auto, 1 On, 2 Off -->

    <!-- Data field slots. Show: 0 Off, 1 Date, 2 BodyBattery, 3 HeartRate,
